<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Басты тема — AppCompatActivity талап етеді (пер-апп локальдар үшін). -->
    <style name="Theme.Agroland" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/agroland_background</item>
    </style>

    <!-- Жүйелік splash (core-splashscreen) — Theme.Agroland-қа өтеді. -->
    <style name="Theme.Agroland.Splash" parent="Theme.SplashScreen">
        <!-- Фон SplashPage-пен бірдей (ашық/қараңғы тема) — ауысу байқалмайды. -->
        <item name="windowSplashScreenBackground">@color/agroland_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.Agroland</item>
    </style>
</resources>